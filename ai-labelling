def select_items_to_handle(
    items: Sequence[WorkItem],
    force: bool,
    input_fn: Callable[[str], str] = input,
) -> List[WorkItem]:
    """Select which items should be sent to the AI backend."""

    if force:
        return list(items)

    selected_items: List[WorkItem] = []
    for index, item in enumerate(items):
        print_item_details(item)
        answer = prompt_confirmation(
            (
                f"Handle {item.kind.upper()} #{item.number} with AI? "
                "[y/n/a/d/q/?] "
            ),
            allow_apply_all=False,
            input_fn=input_fn,
        )
        if answer == "N":
            print(
                colorize(
                    f"Skipping {item.kind.upper()} #{item.number}.",
                    "magenta",
                    bold=True,
                )
            )
            print()
            continue
        if answer == "D":
            print(
                colorize(
                    "Stopping before remaining items.",
                    "yellow",
                    bold=True,
                )
            )
            break
        if answer == "A":
            selected_items.append(item)
            selected_items.extend(items[index + 1:])
            break
        selected_items.append(item)
    return selected_items


def build_suggestion_result(
    item: WorkItem,
    valid_labels: Sequence[LabelDefinition],
    model: str,
    allow_label_removals: bool,
) -> SuggestionResult:
    """Run the AI backend for one work item and normalize the result."""

    suggestion = get_backend_for_model(model).suggest_labels(
        item,
        valid_labels,
        model,
        allow_label_removals,
    )
    return SuggestionResult(
        item=item,
        label_suggestion=normalize_label_suggestions(
            suggestion,
            valid_labels,
            item.labels,
        ),
    )


def run_ai_batch(
    items: Sequence[WorkItem],
    valid_labels: Sequence[LabelDefinition],
    model: str,
    allow_label_removals: bool,
    input_fn: Callable[[str], str] = input,
) -> List[SuggestionResult]:
    """Run AI suggestions for selected items in parallel."""

    if not items:
        return []

    worker_count = min(len(items), os.cpu_count() or 1)
    print(
        colorize("Running processes: ", "blue", bold=True) + str(worker_count)
    )
    print(
        colorize("AI processing items: ", "blue", bold=True) + str(len(items))
    )
    print()

    if worker_count == 1:
        return [
            result
            for item in items
            for result in [
                build_suggestion_result_with_retry(
                    item,
                    valid_labels,
                    model,
                    allow_label_removals,
                    input_fn=input_fn,
                )
            ]
            if result is not None
        ]

    results: List[Optional[SuggestionResult]] = [None] * len(items)
    with concurrent.futures.ProcessPoolExecutor(
        max_workers=worker_count
    ) as executor:
        future_to_index = {
            executor.submit(
                build_suggestion_result,
                item,
                list(valid_labels),
                model,
                allow_label_removals,
            ): index
            for index, item in enumerate(items)
        }
        for future in concurrent.futures.as_completed(future_to_index):
            index = future_to_index[future]
            try:
                results[index] = future.result()
            except Exception as exc:  # pylint: disable=broad-exception-caught
                print_exception_diagnostics(
                    exc,
                    (
                        "AI suggestion for "
                        f"{items[index].kind.upper()} #{items[index].number}"
                    ),
                )
                should_retry = prompt_yes_no(
                    (
                        f"Retry AI suggestion for "
                        f"{items[index].kind.upper()} "
                        f"#{items[index].number}? "
                    ),
                    default_yes=False,
                    input_fn=input_fn,
                )
                if should_retry:
                    results[index] = build_suggestion_result_with_retry(
                        items[index],
                        valid_labels,
                        model,
                        allow_label_removals,
                        input_fn=input_fn,
                    )
    return [result for result in results if result is not None]


def print_summary(
    item: WorkItem,
    label_suggestion: LabelSuggestion,
    force: bool,
    allow_label_removals: bool,
) -> None:
    """Print the suggested label changes for one work item."""

    addition_action = "would add" if not force else "adding"
    removal_action = "would remove" if not force else "removing"
    print_item_details(item)
    print(colorize("Existing labels:", "blue", bold=True))
    print(format_label_block(item.labels))
    if label_suggestion.add_labels:
        print(
            colorize("Suggested additions:", "green", bold=True)
        )
        print(format_label_block(label_suggestion.add_labels))
    if label_suggestion.remove_labels:
        print(
            colorize("Suggested removals:", "magenta", bold=True)
        )
        print(format_label_block(label_suggestion.remove_labels))
    if label_suggestion.reason:
        print(colorize("Reason:", "blue", bold=True))
        print(format_reason(label_suggestion.reason))
    if label_suggestion.add_labels:
        print(
            colorize("Action: ", "green", bold=True)
            + f"{addition_action} {', '.join(label_suggestion.add_labels)}"
        )
    else:
        print(
            colorize("Action: ", "green", bold=True)
            + "no new labels to add"
        )
    if label_suggestion.remove_labels:
        if allow_label_removals:
            print(
                colorize("Action: ", "magenta", bold=True)
                + f"{removal_action} "
                + f"{', '.join(label_suggestion.remove_labels)}"
            )
        else:
            print(
                colorize("Note: ", "yellow", bold=True)
                + "removals are disabled; rerun with "
                + "'--allow-label-removals' to apply them."
            )
    print()


def review_and_apply_suggestions(
    repo: str,
    suggestion_results: Sequence[SuggestionResult],
    force: bool,
    allow_label_removals: bool,
    input_fn: Callable[[str], str] = input,
) -> None:
    """Review AI suggestions and optionally apply label changes."""

    def apply_label_change_bucket(
        item: WorkItem,
        labels: Sequence[str],
        *,
        removal: bool,
    ) -> None:
        """Handle one label-action bucket for one item."""

        if not labels:
            return

        apply_remaining = force
        skip_remaining = False
        kind_display = "issue" if item.kind == "issue" else "PR"
        prompt_template = (
            "REMOVE the label {label} from {kind} #{number}? [y/n/a/d/q/?] "
            if removal
            else "ADD the label {label} to {kind} #{number}? [y/n/a/d/q/?] "
        )

        for label in labels:
            if skip_remaining:
                break

            should_apply = apply_remaining
            if not should_apply:
                answer = prompt_confirmation(
                    prompt_template.format(
                        label=label,
                        kind=kind_display,
                        number=item.number,
                    ),
                    allow_apply_all=True,
                    input_fn=input_fn,
                )
                if answer == "A":
                    apply_remaining = True
                    should_apply = True
                elif answer == "Y":
                    should_apply = True
                elif answer == "D":
                    skip_remaining = True
                    continue
                elif answer == "N":
                    continue

            if should_apply:
                if removal:
                    remove_label_with_retry(
                        repo,
                        item,
                        label,
                        input_fn=input_fn,
                    )
                else:
                    add_labels_with_retry(
                        repo,
                        item,
                        [label],
                        input_fn=input_fn,
                    )

    for result in suggestion_results:
        print_summary(
            result.item,
            result.label_suggestion,
            force,
            allow_label_removals,
        )
        apply_label_change_bucket(
            result.item,
            result.label_suggestion.add_labels,
            removal=False,
        )
        if allow_label_removals:
            apply_label_change_bucket(
                result.item,
                result.label_suggestion.remove_labels,
                removal=True,
            )


def collect_items(repo: str, args: argparse.Namespace) -> List[WorkItem]:
    """Collect and sort matching issues and pull requests."""

    if not args.include_issues and not args.include_prs:
        return []
    if not args.include_open and not args.include_closed:
        return []

    cutoff = (
        default_cutoff()
        if args.date is DEFAULT_DATE_CUTOFF
        else args.date
    )
    search_options = SearchOptions(
        include_open=args.include_open,
        include_closed=args.include_closed,
        created=args.created,
        cutoff=cutoff,
        limit=args.limit,
    )
    items: List[WorkItem] = []
    process_issues = args.include_issues
    process_prs = args.include_prs

    if process_issues:
        items.extend(search_items(repo, "issue", search_options))
    if process_prs:
        remaining = (
            None if args.limit is None else max(args.limit - len(items), 0)
        )
        if remaining is None or remaining > 0:
            pr_options = SearchOptions(
                include_open=args.include_open,
                include_closed=args.include_closed,
                created=args.created,
                cutoff=cutoff,
                limit=remaining,
            )
            items.extend(search_items(repo, "pr", pr_options))

    if args.created:
        items.sort(
            key=lambda item: parse_github_timestamp(item.created_at),
            reverse=True,
        )
    else:
        items.sort(
            key=lambda item: parse_github_timestamp(item.updated_at),
            reverse=True,
        )
    if args.limit is not None:
        return items[: args.limit]
    return items


def describe_match_bucket(items: Sequence[WorkItem]) -> str:
    """Describe one homogeneous matched-item bucket for summary output."""

    if not items:
        return "items"

    state = items[0].state.casefold()
    kind = items[0].kind
    kind_label = "issues" if kind == "issue" else "PRs"
    return f"{state} {kind_label}"


def bucketize_items(
    items: Sequence[WorkItem],
) -> Dict[str, List[WorkItem]]:
    """Group items by open/closed state and by issue-vs-PR kind."""

    buckets: Dict[str, List[WorkItem]] = {}
    for item in items:
        state = item.state.casefold()
        kind_label = "issues" if item.kind == "issue" else "PRs"
        key = f"{state} {kind_label}"
        buckets.setdefault(key, []).append(item)
    return buckets


def print_match_summary(items: Sequence[WorkItem]) -> None:
    """Print a compact matched-item count summary."""

    buckets = bucketize_items(items)
    if len(buckets) == 1:
        label, bucket_items = next(iter(buckets.items()))
        print(
            colorize("Matched ", "blue", bold=True)
            + f"{label}: {len(bucket_items)}"
        )
        return

    print(colorize("Matched items:", "blue", bold=True))
    for label, bucket_items in buckets.items():
        words = label.split(" ", maxsplit=1)
        state = words[0].capitalize()
        suffix = words[1]
        print(f"  - {state} {suffix}: {len(bucket_items)}")


def main() -> int:  # pylint: disable=too-many-branches,too-many-statements
    """Run the end-to-end labelling workflow."""

    args = parse_args()

    repo = args.repo or detect_repo()

    valid_labels = list_repo_labels(repo)
    if not valid_labels:
        raise RuntimeError(f"repository {repo} has no labels")

    items = collect_items(repo, args)

    if not items:
        print(
            colorize(
                "No matching issues or pull requests found.",
                "yellow",
                bold=True,
            )
        )
        return 0

    print(colorize("Repository: ", "blue", bold=True) + repo)
    print(
        colorize("Labels: ", "blue", bold=True)
        + str(len(valid_labels))
    )
    print()
    print_match_summary(items)
    print()
    print_matching_items(items, "Matching items")

    if args.force:
        warn_force_mode()

    selected_items = select_items_to_handle(items, args.force)
    if not selected_items:
        print(
            colorize(
                "No items selected for AI handling.",
                "yellow",
                bold=True,
            )
        )
        return 0

    suggestion_results = run_ai_batch(
        selected_items,
        valid_labels,
        args.model,
        args.allow_label_removals,
        input_fn=input,
    )
    review_and_apply_suggestions(
        repo,
        suggestion_results,
        args.force,
        args.allow_label_removals,
    )

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except UserQuit:
        print(
            colorize(
                "Quit requested. Terminating immediately.",
                "yellow",
                bold=True,
            )
        )
        raise SystemExit(0) from None
    except subprocess.CalledProcessError as exc:
        if exc.stdout:
            print(
                exc.stdout,
                file=sys.stderr,
                end="" if exc.stdout.endswith("\n") else "\n",
            )
        if exc.stderr:
            print(
                exc.stderr,
                file=sys.stderr,
                end="" if exc.stderr.endswith("\n") else "\n",
            )
        raise SystemExit(exc.returncode) from exc
    except RuntimeError as exc:
        print(
            colorize(f"error: {exc}", "red", stream=sys.stderr, bold=True),
            file=sys.stderr,
        )
        raise SystemExit(1) from exc
